{
  "name": "modmynethack-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Modern 2D web frontend for ModMyNetHack. Consumes targets/wasm/nethack.{js,wasm} via the libnh + winshim seam.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "playwright test",
    "build:atlas": "tsx scripts/buildTileManifest.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^25.6.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
